{
  "buildCommand": "npx quartz build",
  "outputDirectory": "public",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/html/:path*", "destination": "/static/html/:path*" },
    { "source": "/books/:path*", "destination": "/static/books/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=UTF-8"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=UTF-8"
        }
      ]
    }
  ]
}
